@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components.Authorization
@using Apteka.Identity.Contracts
@using Apteka.Web.Features.Identity.Session
@using Apteka.Web.Features.Shared

<div class="shell @(_menuOpen ? "menu-open" : null)">
  <aside class="sidebar">
    <a class="brand" href="">
      <span class="brand-mark"><Icon Name="pill" Size="20" /></span>
      <span>Аптека</span>
    </a>

    <AuthorizeView>
      <nav @onclick="() => _menuOpen = false">
        <NavLink href="" Match="NavLinkMatch.All"><Icon Name="home" /> Начало</NavLink>

        <p class="nav-group">Продажби</p>
        <NavLink href="sales/checkout"><Icon Name="till" /> Каса</NavLink>
        <NavLink href="sales/daily"><Icon Name="receipt" /> Продажби за деня</NavLink>

        <p class="nav-group">Склад</p>
        <NavLink href="inventory/stock"><Icon Name="boxes" /> Наличност</NavLink>
        <NavLink href="purchasing/deliveries"><Icon Name="truck" /> Доставки</NavLink>
        <NavLink href="purchasing/suppliers"><Icon Name="building" /> Доставчици</NavLink>

        <p class="nav-group">Номенклатура</p>
        <NavLink href="catalog" Match="NavLinkMatch.All"><Icon Name="pill" /> Стоки</NavLink>
        <NavLink href="catalog/manufacturers"><Icon Name="factory" /> Производители</NavLink>
        <NavLink href="catalog/groups"><Icon Name="layers" /> Групи</NavLink>
        <NavLink href="catalog/shelves"><Icon Name="shelf" /> Рафтове</NavLink>

        <AuthorizeView Roles="@Roles.Manager" Context="manager">
          <p class="nav-group">Администрация</p>
          <NavLink href="identity/users"><Icon Name="users" /> Потребители</NavLink>
        </AuthorizeView>
      </nav>

      <form method="post" action="account/logout" class="user-box">
        <AntiforgeryToken />
        <span class="avatar">@Initials(context.User.DisplayName())</span>
        <span class="user-name">
          <strong>@context.User.DisplayName()</strong>
          <small>@(context.User.IsInRole(Roles.Manager) ? "Управител" : "Фармацевт")</small>
        </span>
        <button type="submit" class="icon-button" title="Изход" aria-label="Изход"><Icon Name="logout" /></button>
      </form>
    </AuthorizeView>
  </aside>

  <div class="main">
    <header class="mobile-bar">
      <button class="icon-button" @onclick="() => _menuOpen = !_menuOpen" aria-label="Меню"><Icon Name="menu" /></button>
      <span class="brand-text">Аптека</span>
    </header>
    <main class="content">
      @Body
    </main>
  </div>
</div>

@code {
  private bool _menuOpen;

  /// <summary>First letters of the first two words that start with a letter („Управител (демо)“ → „УД“).</summary>
  private static string Initials(string name) =>
    string.Concat(name.Split(' ', StringSplitOptions.RemoveEmptyEntries)
      .Select(word => word.FirstOrDefault(char.IsLetter))
      .Where(letter => letter != default)
      .Take(2)
      .Select(char.ToUpperInvariant));
}
