@page "/sales/checkout"
@implements IAsyncDisposable
@using System.Globalization
@using Apteka.Sales.Application.Checkout
@using Apteka.Sales.Domain.Sales
@using Apteka.Web.Features.Shared
@using Microsoft.JSInterop
@inject FindTillProductHandler FindProduct
@inject CompleteSaleHandler CompleteSale
@inject IJSRuntime JS

<PageTitle>Каса</PageTitle>

<h1>Каса</h1>

<div class="till">
  <section class="till-main">
    <div class="till-entry card">
      <label for="till-input" class="till-prompt">@Prompt</label>
      <input id="till-input" class="till-input" autocomplete="off" placeholder="Сканирайте баркод…" @bind="_input" @bind:event="oninput" @onkeydown="OnKeyDown" />

      @if (_error is not null)
      {
        <p class="alert error" role="alert">@_error</p>
      }

      @if (_mode == Mode.Choose)
      {
        <ol class="till-matches">
          @foreach (var match in _matches)
          {
            <li><span>@match.Name</span> <span class="muted">@match.UnitName · @Formats.Euro(match.UnitPrice)</span></li>
          }
        </ol>
      }
    </div>

    @if (_cart.IsEmpty)
    {
      <div class="till-empty card">
        <Icon Name="till" Size="36" />
        <p>Няма стоки в бележката. Сканирайте баркод или напишете име.</p>
      </div>
    }
    else
    {
      <table class="grid till-lines">
        <thead>
          <tr><th>№</th><th>Стока</th><th>Мярка</th><th class="num">Кол.</th><th class="num">Цена</th><th class="num">Отст. %</th><th class="num">Сума</th></tr>
        </thead>
        <tbody>
          @for (var i = 0; i < _cart.Lines.Count; i++)
          {
            var line = _cart.Lines[i];
            <tr class="@(line == _cart.Last ? "current" : null) @(line.ExceedsStock ? "short" : null)">
              <td>@(i + 1)</td>
              <td>
                @line.Product.Name
                @if (line.PrescriptionConfirmed)
                {
                  <span class="tag" title="Рецептата е потвърдена">Rx</span>
                }
                @if (line.ExceedsStock)
                {
                  <span class="stock-note">налични: @Formats.Quantity(line.Product.AvailableBaseQuantity, [new(line.Product.UnitId, line.Product.UnitName, line.Product.UnitFactor), new(Guid.Empty, "бр. най-малка мярка", 1)])</span>
                }
              </td>
              <td>@line.Product.UnitName</td>
              <td class="num">@line.Quantity</td>
              <td class="num">@Formats.Euro(line.Product.UnitPrice)</td>
              <td class="num">@(line.DiscountPercent == 0 ? null : line.DiscountPercent.ToString("0.##", CultureInfo.GetCultureInfo("bg-BG")))</td>
              <td class="num">@Formats.Euro(line.Total)</td>
            </tr>
          }
        </tbody>
      </table>
    }
  </section>

  <aside class="till-side">
    <div class="till-summary card">
      <span class="muted">За плащане</span>
      <p class="till-total"><strong>@Formats.Euro(_cart.Total)</strong></p>
      <span class="muted">@_cart.Lines.Count @(_cart.Lines.Count == 1 ? "ред" : "реда")</span>
    </div>

    @if (_done is not null)
    {
      <div class="alert success" role="status">
        <span>
          Продажба № @_done.Number — @Formats.Euro(_done.Total)@(_done.Change is { } change ? $" · ресто {Formats.Euro(change)}" : null)
        </span>
      </div>
    }

    <ul class="till-keys card">
      <li><kbd>Enter</kbd> добави / потвърди</li>
      <li><kbd>F2</kbd> количество</li>
      <li><kbd>F3</kbd> отстъпка %</li>
      <li><kbd>F9</kbd> плащане (<kbd>F9</kbd> отново — карта)</li>
      <li><kbd>Esc</kbd> назад / отказ</li>
    </ul>
  </aside>
</div>

@code {
  private enum Mode { Scan, Quantity, Discount, Choose, ConfirmPrescription, Payment, ConfirmCancel }

  private const int MaxMatches = 9;

  private readonly Cart _cart = new();
  private Mode _mode = Mode.Scan;
  private string _input = string.Empty;
  private string? _error;
  private CompletedSale? _done;
  private IReadOnlyList<TillProduct> _matches = [];
  private TillProduct? _pendingPrescription;
  private IJSObjectReference? _module;

  private string Prompt => _mode switch
  {
    Mode.Quantity => $"Количество за „{_cart.Last?.Product.Name}“ и Enter (Esc — назад)",
    Mode.Discount => $"Отстъпка в % за „{_cart.Last?.Product.Name}“ и Enter (Esc — назад)",
    Mode.Choose => "Номер от списъка и Enter (Esc — назад)",
    Mode.ConfirmPrescription => $"„{_pendingPrescription?.Name}“ е по лекарско предписание. Има ли рецепта? Enter — да, Esc — не",
    Mode.Payment => $"Плащане {Formats.Euro(_cart.Total)}: сума в брой и Enter (празно — точна сума) · F9 — с карта · Esc — назад",
    Mode.ConfirmCancel => "Отказ на цялата продажба? Esc — да, Enter — не",
    _ => "Баркод или име на стока и Enter",
  };

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      _module = await JS.InvokeAsync<IJSObjectReference>("import", "./Features/Sales/Checkout/CheckoutPage.razor.js");
      await _module.InvokeVoidAsync("start");
    }
  }

  private async Task OnKeyDown(KeyboardEventArgs e)
  {
    switch (e.Key)
    {
      case "Enter":
        await OnEnter();
        break;
      case "F2" when _mode == Mode.Scan && _cart.Last is not null:
        Switch(Mode.Quantity);
        break;
      case "F3" when _mode == Mode.Scan && _cart.Last is not null:
        Switch(Mode.Discount);
        break;
      case "F9" when _mode == Mode.Scan && !_cart.IsEmpty:
        Switch(Mode.Payment);
        break;
      case "F9" when _mode == Mode.Payment:
        await Pay(PaymentMethod.Card, null);
        break;
      case "Escape":
        OnEscape();
        break;
    }
  }

  private async Task OnEnter()
  {
    var text = _input.Trim();
    _input = string.Empty;
    _error = null;

    switch (_mode)
    {
      case Mode.Scan when text.Length > 0:
        _done = null;
        await Find(text);
        break;
      case Mode.Quantity:
        if (int.TryParse(text, out var quantity) && quantity > 0)
        {
          _cart.Last!.Quantity = quantity;
          Switch(Mode.Scan);
        }
        else
        {
          _error = "Въведете цяло число, по-голямо от нула.";
        }

        break;
      case Mode.Discount:
        if (decimal.TryParse(text.Replace(',', '.'), NumberStyles.Number, CultureInfo.InvariantCulture, out var discount) && discount is >= 0 and <= 100)
        {
          _cart.Last!.DiscountPercent = discount;
          Switch(Mode.Scan);
        }
        else
        {
          _error = "Въведете отстъпка от 0 до 100 %.";
        }

        break;
      case Mode.Choose:
        if (int.TryParse(text, out var number) && number >= 1 && number <= _matches.Count)
        {
          Add(_matches[number - 1]);
        }
        else
        {
          _error = $"Въведете номер от 1 до {_matches.Count}.";
        }

        break;
      case Mode.ConfirmPrescription:
        _cart.Add(_pendingPrescription!, prescriptionConfirmed: true);
        _pendingPrescription = null;
        Switch(Mode.Scan);
        break;
      case Mode.Payment:
        if (text.Length == 0)
        {
          await Pay(PaymentMethod.Cash, _cart.Total);
        }
        else if (decimal.TryParse(text.Replace(',', '.'), NumberStyles.Number, CultureInfo.InvariantCulture, out var cash))
        {
          await Pay(PaymentMethod.Cash, cash);
        }
        else
        {
          _error = "Въведете сума, например 20 или 20,50.";
        }

        break;
      case Mode.ConfirmCancel:
        Switch(Mode.Scan);
        break;
    }
  }

  private void OnEscape()
  {
    _input = string.Empty;
    _error = null;

    if (_mode == Mode.ConfirmCancel)
    {
      _cart.Clear();
      Switch(Mode.Scan);
    }
    else if (_mode != Mode.Scan)
    {
      _pendingPrescription = null;
      Switch(Mode.Scan);
    }
    else if (!_cart.IsEmpty)
    {
      Switch(Mode.ConfirmCancel);
    }
  }

  /// <summary>Digits are a barcode; anything else searches by name (one match is added at once).</summary>
  private async Task Find(string text)
  {
    if (text.All(char.IsAsciiDigit))
    {
      var found = await FindProduct.ByBarcodeAsync(text);
      if (found.IsFailure)
      {
        _error = found.Error.Message;
        return;
      }

      Add(found.Value);
      return;
    }

    var matches = await FindProduct.ByNameAsync(text, MaxMatches);
    if (matches.IsFailure)
    {
      _error = matches.Error.Message;
    }
    else if (matches.Value.Count == 1)
    {
      Add(matches.Value[0]);
    }
    else
    {
      _matches = matches.Value;
      Switch(Mode.Choose);
    }
  }

  private void Add(TillProduct product)
  {
    _matches = [];
    var alreadyConfirmed = _cart.Lines.Any(l => l.Product.ProductId == product.ProductId && l.PrescriptionConfirmed);
    if (product.NeedsPrescription && !alreadyConfirmed)
    {
      _pendingPrescription = product;
      Switch(Mode.ConfirmPrescription);
      return;
    }

    _cart.Add(product, alreadyConfirmed);
    Switch(Mode.Scan);
  }

  private async Task Pay(PaymentMethod method, decimal? cash)
  {
    var result = await CompleteSale.HandleAsync(new CheckoutInput(_cart.ToInput(), method, cash));
    if (result.IsFailure)
    {
      _error = result.Error.Message;
      return;
    }

    _done = result.Value;
    _cart.Clear();
    Switch(Mode.Scan);
  }

  private void Switch(Mode mode)
  {
    _mode = mode;
    _input = string.Empty;
  }

  public async ValueTask DisposeAsync()
  {
    if (_module is not null)
    {
      try
      {
        await _module.InvokeVoidAsync("stop");
        await _module.DisposeAsync();
      }
      catch (JSDisconnectedException)
      {
        // The browser is gone; nothing to clean up.
      }
    }
  }
}
