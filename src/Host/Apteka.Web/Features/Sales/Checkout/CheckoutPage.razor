@page "/sales/checkout"
@implements IAsyncDisposable
@using System.Globalization
@using Apteka.Sales.Application.Checkout
@using Apteka.Sales.Domain.Sales
@using Apteka.SharedKernel
@using Apteka.Web.Features.Shared
@using Microsoft.JSInterop
@inject FindTillProductHandler FindProduct
@inject CompleteSaleHandler CompleteSale
@inject Apteka.Sales.Application.Customers.CustomersHandler Customers
@inject TimeProvider Clock
@inject IJSRuntime JS

@* „Директна продажба“, with the keys of Apteka Expert 2. *@

<PageTitle>Директна продажба</PageTitle>

<h1>Директна продажба <span class="muted till-date">@Formats.Date(BulgarianTime.Today(Clock.GetUtcNow()))</span></h1>

<div class="till">
  <section class="till-main">
    <div class="till-entry card">
      <label for="till-input" class="till-prompt">@Prompt</label>
      <input id="till-input" class="till-input" autocomplete="off" placeholder="Код, баркод, име или 3*баркод…"
             @bind="_input" @bind:event="oninput" @onkeydown="OnKeyDown" />

      @if (_error is not null)
      {
        <p class="alert error" role="alert">@_error</p>
      }

      @if (_mode == Mode.Choose)
      {
        <ol class="till-matches">
          @foreach (var match in _matches)
          {
            <li><span>@match.Name</span> <span class="muted">@match.UnitName · @Formats.Euro(match.UnitPrice)</span></li>
          }
        </ol>
      }

      @if (_mode == Mode.ChooseCustomer)
      {
        <ol class="till-matches">
          @foreach (var match in _customerMatches)
          {
            <li><span>@match.Name</span> <span class="muted mono">@match.Egn</span> <span class="muted">№ @match.Code</span></li>
          }
        </ol>
      }

      @if (_cart.Current is { } current)
      {
        <dl class="current-item">
          <div><dt>Стока</dt><dd>@current.Product.Name</dd></div>
          <div><dt>Мярка</dt><dd>@current.Product.UnitName</dd></div>
          <div><dt>Цена</dt><dd>@Formats.Euro(current.Product.UnitPrice)</dd></div>
          <div class="@(current.ExceedsStock ? "short" : null)"><dt>Налично</dt><dd>@Formats.Quantity(current.Product.AvailableBaseQuantity, current.Product.AllUnits)</dd></div>
          <div><dt>Рафт</dt><dd>@(current.Product.ShelfName ?? "—")</dd></div>
        </dl>
      }
    </div>

    @if (_cart.IsEmpty)
    {
      <div class="till-empty card">
        <Icon Name="till" Size="36" />
        <p>Няма стоки. Сканирайте баркод или напишете име на стока и Enter.</p>
      </div>
    }
    else
    {
      <table class="grid till-lines">
        <thead>
          <tr><th>№</th><th>Наименование</th><th class="num">Кол.</th><th>Мярка</th><th class="num">Ед. цена</th><th class="num">ТО %</th><th class="num">Стойност</th></tr>
        </thead>
        <tbody>
          @for (var i = 0; i < _cart.Lines.Count; i++)
          {
            var line = _cart.Lines[i];
            <tr class="@(i == _cart.CurrentIndex ? "current" : null) @(line.ExceedsStock ? "short" : null)">
              <td>@(i + 1)</td>
              <td>
                @line.Product.Name
                @if (line.PrescriptionConfirmed)
                {
                  <span class="tag" title="Рецептата е потвърдена">Rx</span>
                }
              </td>
              <td class="num">@line.Quantity</td>
              <td>@line.Product.UnitName</td>
              <td class="num">@Formats.Euro(line.Product.UnitPrice)</td>
              <td class="num">@(line.DiscountPercent == 0 ? null : line.DiscountPercent.ToString("0.##", CultureInfo.GetCultureInfo("bg-BG")))</td>
              <td class="num">@Formats.Euro(line.Total)</td>
            </tr>
          }
        </tbody>
      </table>
    }

    <div class="till-sum card">
      @if (_customer is { } customer)
      {
        <span class="till-customer">Клиент: <strong>@customer.Name</strong> <span class="muted mono">@customer.Egn</span></span>
      }
      <span>Ст-ст без ТО: <strong>@Formats.Euro(_cart.Gross)</strong></span>
      <span>– ТО@(_cart.OverallDiscountPercent > 0 ? $" (обща {_cart.OverallDiscountPercent.ToString("0.##", CultureInfo.GetCultureInfo("bg-BG"))} %)" : null): <strong>@Formats.Euro(_cart.Discount)</strong></span>
      <span class="till-total">= СУМА: <strong>@Formats.Euro(_cart.Total)</strong></span>
    </div>
  </section>

  <aside class="till-side">
    @if (_done is not null)
    {
      <div class="alert success" role="status">
        <span>
          Продажба № @_done.Number — @Formats.Euro(_done.Total)@(_done.Change is { } change ? $" · ресто {Formats.Euro(change)}" : null)
        </span>
      </div>
    }

    <ul class="till-keys card">
      <li><kbd>Enter</kbd> добави стока</li>
      <li><kbd>3*</kbd> + баркод — количество 3; <kbd>3*</kbd> + Enter — количество на текущия ред</li>
      <li><kbd>↑</kbd> <kbd>↓</kbd> избор на ред</li>
      <li><kbd>F2</kbd> клиент (ЕГН, код, телефон или име)</li>
      <li><kbd>F4</kbd> отстъпка (ТО %) на реда</li>
      <li><kbd>%10</kbd> + Enter — обща ТО 10 % на цялата продажба</li>
      <li><kbd>F12</kbd> смяна на мярката</li>
      <li><kbd>F8</kbd> изтрий реда</li>
      <li><kbd>F10</kbd> плащане и ресто</li>
      <li><kbd>Ctrl+Enter</kbd> приключи (в брой, точна сума)</li>
      <li><kbd>Esc</kbd> назад / отказ</li>
    </ul>

    <a class="button secondary" href="sales/daily"><Icon Name="receipt" /> Директни продажби (за деня)</a>
  </aside>
</div>

@code {
  private enum Mode { Scan, Discount, Choose, ConfirmPrescription, Payment, ConfirmCancel, Customer, ChooseCustomer }

  private const int MaxMatches = 9;

  private readonly Cart _cart = new();
  private Mode _mode = Mode.Scan;
  private string _input = string.Empty;
  private string? _error;
  private CompletedSale? _done;
  private IReadOnlyList<TillProduct> _matches = [];
  private (TillProduct Product, int Quantity)? _pendingPrescription;
  private int _pendingQuantity = 1;
  private IJSObjectReference? _module;
  private Apteka.Sales.Application.Customers.CustomerListItem? _customer;
  private IReadOnlyList<Apteka.Sales.Application.Customers.CustomerListItem> _customerMatches = [];

  private string Prompt => _mode switch
  {
    Mode.Discount => $"Отстъпка (ТО %) за „{_cart.Current?.Product.Name}“ и Enter (Esc — назад)",
    Mode.Choose or Mode.ChooseCustomer => "Номер от списъка и Enter (Esc — назад)",
    Mode.Customer => "Клиент: ЕГН, код, телефон или име и Enter (празно — без клиент · Esc — назад)",
    Mode.ConfirmPrescription => $"„{_pendingPrescription?.Product.Name}“ е по лекарско предписание. Има ли рецепта? Enter — да, Esc — не",
    Mode.Payment => $"Плащане {Formats.Euro(_cart.Total)}: получена сума в брой и Enter (празно — точна сума) · F10 — с карта · Esc — назад",
    Mode.ConfirmCancel => "Отказ на цялата продажба? Esc — да, Enter — не",
    _ => "Стока: код, баркод или име и Enter",
  };

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      _module = await JS.InvokeAsync<IJSObjectReference>("import", "./Features/Sales/Checkout/CheckoutPage.razor.js");
      await _module.InvokeVoidAsync("start");
    }
  }

  private async Task OnKeyDown(KeyboardEventArgs e)
  {
    switch (e.Key)
    {
      case "Enter" when e.CtrlKey:
        await Complete();
        break;
      case "Enter":
        await OnEnter();
        break;
      case "ArrowUp" when _mode == Mode.Scan:
        _cart.Move(-1);
        break;
      case "ArrowDown" when _mode == Mode.Scan:
        _cart.Move(1);
        break;
      case "F2" when _mode == Mode.Scan:
        Switch(Mode.Customer);
        break;
      case "F4" when _mode == Mode.Scan && _cart.Current is not null:
        Switch(Mode.Discount);
        break;
      case "F8" when _mode == Mode.Scan:
        _cart.RemoveCurrent();
        break;
      case "F12" when _mode == Mode.Scan && _cart.Current is not null:
        await ChangeUnit();
        break;
      case "F10" when _mode == Mode.Scan && !_cart.IsEmpty:
        Switch(Mode.Payment);
        break;
      case "F10" when _mode == Mode.Payment:
        await Pay(PaymentMethod.Card, null);
        break;
      case "Escape":
        OnEscape();
        break;
    }
  }

  private async Task OnEnter()
  {
    var text = _input.Trim();
    _input = string.Empty;
    _error = null;

    switch (_mode)
    {
      case Mode.Scan when text.StartsWith('%'):
        SetOverallDiscount(text[1..]);
        break;
      case Mode.Scan when text.Length > 0:
        _done = null;
        await Scan(text);
        break;
      case Mode.Discount:
        if (decimal.TryParse(text.Replace(',', '.'), NumberStyles.Number, CultureInfo.InvariantCulture, out var discount) && discount is >= 0 and <= 100)
        {
          _cart.Current!.DiscountPercent = discount;
          Switch(Mode.Scan);
        }
        else
        {
          _error = "Въведете отстъпка от 0 до 100 %.";
        }

        break;
      case Mode.Choose:
        if (int.TryParse(text, out var number) && number >= 1 && number <= _matches.Count)
        {
          Add(_matches[number - 1], _pendingQuantity);
        }
        else
        {
          _error = $"Въведете номер от 1 до {_matches.Count}.";
        }

        break;
      case Mode.Customer:
        await FindCustomer(text);
        break;
      case Mode.ChooseCustomer:
        if (int.TryParse(text, out var chosen) && chosen >= 1 && chosen <= _customerMatches.Count)
        {
          _customer = _customerMatches[chosen - 1];
          Switch(Mode.Scan);
        }
        else
        {
          _error = $"Въведете номер от 1 до {_customerMatches.Count}.";
        }

        break;
      case Mode.ConfirmPrescription:
        var (product, quantity) = _pendingPrescription!.Value;
        _cart.Add(product, quantity, prescriptionConfirmed: true);
        _pendingPrescription = null;
        Switch(Mode.Scan);
        break;
      case Mode.Payment:
        if (text.Length == 0)
        {
          await Pay(PaymentMethod.Cash, _cart.Total);
        }
        else if (decimal.TryParse(text.Replace(',', '.'), NumberStyles.Number, CultureInfo.InvariantCulture, out var cash))
        {
          await Pay(PaymentMethod.Cash, cash);
        }
        else
        {
          _error = "Въведете сума, например 20 или 20,50.";
        }

        break;
      case Mode.ConfirmCancel:
        Switch(Mode.Scan);
        break;
    }
  }

  /// <summary>„%10“: overall discount (Обща ТО) for the whole sale; „%0“ removes it.</summary>
  private void SetOverallDiscount(string text)
  {
    if (decimal.TryParse(text.Replace(',', '.'), NumberStyles.Number, CultureInfo.InvariantCulture, out var discount) && discount is >= 0 and <= 100)
    {
      _cart.SetOverallDiscount(discount);
    }
    else
    {
      _error = "Обща отстъпка: % и число от 0 до 100, например %10.";
    }
  }

  /// <summary>
  /// F2: 10 digits are an ЕГН, up to 7 digits a customer code, other digits a phone, anything else part of the name.
  /// Empty removes the customer from the sale.
  /// </summary>
  private async Task FindCustomer(string text)
  {
    if (text.Length == 0)
    {
      _customer = null;
      Switch(Mode.Scan);
      return;
    }

    var digits = text.Replace(" ", string.Empty, StringComparison.Ordinal);
    var field = digits.All(char.IsAsciiDigit)
      ? digits.Length == 10 ? Apteka.Sales.Application.Customers.CustomerSearchField.Egn
        : digits.Length <= 7 ? Apteka.Sales.Application.Customers.CustomerSearchField.Code
        : Apteka.Sales.Application.Customers.CustomerSearchField.Phone
      : Apteka.Sales.Application.Customers.CustomerSearchField.Name;
    var found = await Customers.SearchAsync(field, text);
    switch (found.Count)
    {
      case 0:
        _error = $"Няма клиент с „{text}“.";
        break;
      case 1:
        _customer = found[0];
        Switch(Mode.Scan);
        break;
      default:
        _customerMatches = [.. found.Take(MaxMatches)];
        Switch(Mode.ChooseCustomer);
        break;
    }
  }

  /// <summary>„3*“ sets the quantity: alone for the current line, before a barcode or name for the new one.</summary>
  private async Task Scan(string text)
  {
    var quantity = 1;
    var star = text.IndexOf('*');
    if (star > 0 && int.TryParse(text[..star], out var parsed) && parsed > 0)
    {
      quantity = parsed;
      text = text[(star + 1)..].Trim();
      if (text.Length == 0)
      {
        if (_cart.Current is { } current)
        {
          current.Quantity = quantity;
        }

        return;
      }
    }

    await Find(text, quantity);
  }

  /// <summary>A short number is a product code, a long one a barcode; anything else searches by name.</summary>
  private async Task Find(string text, int quantity)
  {
    if (Apteka.Catalog.Contracts.CatalogCodes.LooksLikeCode(text))
    {
      var byCode = await FindProduct.ByCodeAsync(long.Parse(text, CultureInfo.InvariantCulture));
      if (byCode.IsFailure)
      {
        _error = byCode.Error.Message;
        return;
      }

      Add(byCode.Value, quantity);
      return;
    }

    if (text.All(char.IsAsciiDigit) || Apteka.Catalog.Contracts.Gs1Code.LooksLikeGs1(text))
    {
      var found = await FindProduct.ByBarcodeAsync(text);
      if (found.IsFailure)
      {
        _error = found.Error.Message;
        return;
      }

      Add(found.Value, quantity);
      return;
    }

    var matches = await FindProduct.ByNameAsync(text, MaxMatches);
    if (matches.IsFailure)
    {
      _error = matches.Error.Message;
    }
    else if (matches.Value.Count == 1)
    {
      Add(matches.Value[0], quantity);
    }
    else
    {
      _matches = matches.Value;
      _pendingQuantity = quantity;
      Switch(Mode.Choose);
    }
  }

  private void Add(TillProduct product, int quantity)
  {
    _matches = [];
    var alreadyConfirmed = _cart.Lines.Any(l => l.Product.ProductId == product.ProductId && l.PrescriptionConfirmed);
    if (product.NeedsPrescription && !alreadyConfirmed)
    {
      _pendingPrescription = (product, quantity);
      Switch(Mode.ConfirmPrescription);
      return;
    }

    _cart.Add(product, quantity, alreadyConfirmed);
    Switch(Mode.Scan);
  }

  /// <summary>F12: the next unit of the product (box → blister → tablet → box …).</summary>
  private async Task ChangeUnit()
  {
    var current = _cart.Current!;
    var units = current.Product.AllUnits.OrderByDescending(u => u.Factor).ToList();
    if (units.Count < 2)
    {
      return;
    }

    var next = units[(units.FindIndex(u => u.UnitId == current.Product.UnitId) + 1) % units.Count];
    var priced = await FindProduct.InUnitAsync(current.Product.ProductId, next.UnitId);
    if (priced.IsFailure)
    {
      _error = priced.Error.Message;
      return;
    }

    _cart.ReplaceCurrent(priced.Value);
  }

  private void OnEscape()
  {
    _input = string.Empty;
    _error = null;

    if (_mode == Mode.ConfirmCancel)
    {
      _cart.Clear();
      _customer = null;
      Switch(Mode.Scan);
    }
    else if (_mode != Mode.Scan)
    {
      _pendingPrescription = null;
      Switch(Mode.Scan);
    }
    else if (!_cart.IsEmpty)
    {
      Switch(Mode.ConfirmCancel);
    }
  }

  /// <summary>Ctrl+Enter: finish the sale. In the payment step it takes the typed cash; otherwise exact cash.</summary>
  private async Task Complete()
  {
    if (_cart.IsEmpty)
    {
      return;
    }

    var text = _input.Trim();
    if (_mode == Mode.Payment && decimal.TryParse(text.Replace(',', '.'), NumberStyles.Number, CultureInfo.InvariantCulture, out var cash))
    {
      await Pay(PaymentMethod.Cash, cash);
      return;
    }

    await Pay(PaymentMethod.Cash, _cart.Total);
  }

  private async Task Pay(PaymentMethod method, decimal? cash)
  {
    _input = string.Empty;
    var result = await CompleteSale.HandleAsync(new CheckoutInput(_cart.ToInput(), method, cash, _customer?.Id));
    if (result.IsFailure)
    {
      _error = result.Error.Message;
      return;
    }

    _done = result.Value;
    _cart.Clear();
    _customer = null;
    Switch(Mode.Scan);
  }

  private void Switch(Mode mode)
  {
    _mode = mode;
    _input = string.Empty;
  }

  public async ValueTask DisposeAsync()
  {
    if (_module is not null)
    {
      try
      {
        await _module.InvokeVoidAsync("stop");
        await _module.DisposeAsync();
      }
      catch (JSDisconnectedException)
      {
        // The browser is gone; nothing to clean up.
      }
    }
  }
}
