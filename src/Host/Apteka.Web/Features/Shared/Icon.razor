@* Line icons drawn inline (no icon font, no CDN). Shapes follow the Lucide style (ISC licence). *@

<svg class="icon" width="@Size" height="@Size" viewBox="0 0 24 24" fill="none" stroke="currentColor"
     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  @switch (Name)
  {
    case "home":
      <path d="M3 10.5 12 3l9 7.5" /><path d="M5 9.5V21h14V9.5" /><path d="M10 21v-6h4v6" />
      break;
    case "till":
      <rect x="3" y="4" width="18" height="12" rx="2" /><path d="M7 20h10" /><path d="M12 16v4" /><path d="M7 8h4" /><path d="M7 12h10" />
      break;
    case "receipt":
      <path d="M5 3v18l2-1.5L9 21l2-1.5L13 21l2-1.5L17 21l2-1.5V3l-2 1.5L15 3l-2 1.5L11 3 9 4.5 7 3z" /><path d="M9 9h6" /><path d="M9 13h6" />
      break;
    case "pill":
      <path d="M10.5 20.5a5 5 0 0 1-7-7l7-7a5 5 0 0 1 7 7z" /><path d="m8.5 8.5 7 7" />
      break;
    case "factory":
      <path d="M3 21V10l6 4V10l6 4V6l6 3v12z" /><path d="M7 17h2" /><path d="M13 17h2" />
      break;
    case "layers":
      <path d="m12 3 9 5-9 5-9-5z" /><path d="m3 13 9 5 9-5" />
      break;
    case "shelf":
      <path d="M4 4v16" /><path d="M20 4v16" /><path d="M4 9h16" /><path d="M4 15h16" /><rect x="7" y="5" width="3" height="4" /><rect x="13" y="11" width="4" height="4" />
      break;
    case "truck":
      <path d="M3 6h11v10H3z" /><path d="M14 9h4l3 3v4h-7" /><circle cx="7" cy="18" r="2" /><circle cx="17" cy="18" r="2" />
      break;
    case "building":
      <rect x="5" y="3" width="14" height="18" rx="1" /><path d="M9 7h2" /><path d="M13 7h2" /><path d="M9 11h2" /><path d="M13 11h2" /><path d="M10 21v-4h4v4" />
      break;
    case "boxes":
      <path d="M12 3 4 7v10l8 4 8-4V7z" /><path d="m4 7 8 4 8-4" /><path d="M12 11v10" />
      break;
    case "users":
      <circle cx="9" cy="8" r="3.5" /><path d="M2.5 20a6.5 6.5 0 0 1 13 0" /><path d="M16 4.5a3.5 3.5 0 0 1 0 7" /><path d="M18 14a6.5 6.5 0 0 1 3.5 6" />
      break;
    case "logout":
      <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><path d="m16 17 5-5-5-5" /><path d="M21 12H9" />
      break;
    case "alert":
      <path d="M12 3 2 21h20z" /><path d="M12 10v4" /><path d="M12 17.5v.01" />
      break;
    case "clock":
      <circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" />
      break;
    case "plus":
      <path d="M12 5v14" /><path d="M5 12h14" />
      break;
    case "menu":
      <path d="M4 6h16" /><path d="M4 12h16" /><path d="M4 18h16" />
      break;
    case "coins":
      <ellipse cx="12" cy="6" rx="7" ry="3" /><path d="M5 6v6c0 1.7 3.1 3 7 3s7-1.3 7-3V6" /><path d="M5 12v6c0 1.7 3.1 3 7 3s7-1.3 7-3v-6" />
      break;
    case "card":
      <rect x="2" y="5" width="20" height="14" rx="2" /><path d="M2 10h20" /><path d="M6 15h4" />
      break;
    case "draft":
      <path d="M4 20h4L19 9l-4-4L4 16z" /><path d="m13.5 6.5 4 4" />
      break;
    default:
      <circle cx="12" cy="12" r="9" />
      break;
  }
</svg>

@code {
  [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;

  [Parameter] public int Size { get; set; } = 18;
}
