@implements IAsyncDisposable
@using Microsoft.JSInterop
@inject IJSRuntime JS

@* F5 = „Добави“, F6 = „Редактирай“ in lists, as in Apteka Expert 2 (the browser's reload on F5 is blocked on these screens). *@

@code {
  [Parameter, EditorRequired] public EventCallback OnAdd { get; set; }

  /// <summary>F6; lists without editing leave it unset.</summary>
  [Parameter] public EventCallback OnEdit { get; set; }

  private IJSObjectReference? _module;
  private DotNetObjectReference<ListKeys>? _self;

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      try
      {
        _self = DotNetObjectReference.Create(this);
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./Features/Shared/ListKeys.razor.js");
        await _module.InvokeVoidAsync("start", _self);
      }
      catch (JSDisconnectedException)
      {
      }
    }
  }

  [JSInvokable]
  public Task OnKey(string key) => key switch
  {
    "F5" => OnAdd.InvokeAsync(),
    "F6" when OnEdit.HasDelegate => OnEdit.InvokeAsync(),
    _ => Task.CompletedTask,
  };

  public async ValueTask DisposeAsync()
  {
    if (_module is not null)
    {
      try
      {
        await _module.InvokeVoidAsync("stop");
        await _module.DisposeAsync();
      }
      catch (JSDisconnectedException)
      {
      }
    }

    _self?.Dispose();
  }
}
