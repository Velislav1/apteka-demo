@page "/catalog/new"
@page "/catalog/{Id:guid}"
@using Apteka.Catalog.Application.Common
@using Apteka.Catalog.Application.Manufacturers
@using Apteka.Catalog.Application.ProductGroups
@using Apteka.Catalog.Application.Products
@using Apteka.Catalog.Application.Shelves
@using Apteka.Catalog.Domain.Products
@using Microsoft.JSInterop
@inject GetProductHandler GetProduct
@inject ManufacturersHandler Manufacturers
@inject ProductGroupsHandler Groups
@inject ShelvesHandler Shelves
@inject CreateProductHandler CreateProduct
@inject UpdateProductHandler UpdateProduct
@inject NavigationManager Navigation
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>@Title</PageTitle>

<h1>@Title @if (_model is { Code: > 0 }) { <span class="product-code">№ @_model.Code</span> }</h1>

@* „Данни за стоката“ as in Apteka Expert 2: the card is split in tabs; F11 opens „Мерки“. *@

@if (_notFound)
{
  <p class="alert error">Стоката не е намерена.</p>
  <a href="catalog">Към номенклатурата</a>
}
else if (_model is not null)
{
  <div class="tabs" role="tablist" aria-label="Данни за стоката">
    @foreach (var (tab, label) in Tabs)
    {
      <button id="tab-@tab" role="tab" aria-selected="@(_tab == tab ? "true" : "false")"
              class="@(_tab == tab ? "active" : null)" @onclick="() => _tab = tab">
        @label
        @if (tab == Tab.Units)
        {
          <kbd>F11</kbd>
        }
      </button>
    }
  </div>

  @if (_tab == Tab.Main)
  {
  <fieldset>
    <legend>Основни данни</legend>
    <div class="form-grid">
      <label for="name">Наименование (кир.)</label>
      <input id="name" @bind="_model.Name" maxlength="200" />

      <label for="latin">Наименование (лат.)</label>
      <input id="latin" @bind="_model.LatinName" maxlength="200" />

      <label for="generic">Генерика</label>
      <input id="generic" @bind="_model.GenericName" maxlength="200" placeholder="напр. Paracetamol" />

      <label for="substance">Активно вещество</label>
      <input id="substance" @bind="_model.ActiveSubstance" maxlength="200" placeholder="напр. Paracetamol 500 mg" />

      <label for="manufacturer">Производител</label>
      <select id="manufacturer" @bind="_model.ManufacturerId">
        <option value="">—</option>
        @foreach (var item in Options(_manufacturers, _model.ManufacturerId))
        {
          <option value="@item.Id">@item.Name</option>
        }
      </select>

      <label for="group">Група</label>
      <select id="group" @bind="_model.ProductGroupId">
        <option value="">—</option>
        @foreach (var item in Options(_groups, _model.ProductGroupId))
        {
          <option value="@item.Id">@item.Name</option>
        }
      </select>

      <label for="shelf">Рафт</label>
      <select id="shelf" @bind="_model.ShelfId">
        <option value="">—</option>
        @foreach (var item in Options(_shelves, _model.ShelfId))
        {
          <option value="@item.Id">@item.Name</option>
        }
      </select>

      <label for="atc">ATC код</label>
      <input id="atc" @bind="_model.AtcCode" maxlength="7" placeholder="напр. N02BE01" />

      <label for="nhif">Код по НЗОК</label>
      <input id="nhif" @bind="_model.NhifCode" maxlength="20" />

      <label for="mode">Режим на отпускане</label>
      <select id="mode" @bind="_model.DispensingMode">
        @foreach (var mode in Enum.GetValues<DispensingMode>())
        {
          <option value="@mode">@DispensingModeText.Label(mode)</option>
        }
      </select>

      <label for="vat">ДДС</label>
      <select id="vat" @bind="_model.VatRate">
        <option value="20">20 %</option>
        <option value="9">9 %</option>
        <option value="0">0 %</option>
      </select>

      <label for="active">Активна</label>
      <input id="active" type="checkbox" @bind="_model.IsActive" />
    </div>
  </fieldset>
  }
  else if (_tab == Tab.Prices)
  {
  <fieldset>
    <legend>Цени и запаси</legend>
    <div class="form-grid">
      <label for="markup">Търг. надценка %</label>
      <input id="markup" type="number" min="0" step="0.01" @bind="_model.MarkupPercent" placeholder="празно — по групата" />

      <label for="minstock">Мин. / макс. запас</label>
      <span class="stock-limits">
        <input id="minstock" type="number" min="0" @bind="_model.MinStock" aria-label="Минимален запас" />
        <span>/</span>
        <input id="maxstock" type="number" min="0" @bind="_model.MaxStock" aria-label="Максимален запас" />
        <span class="muted">в най-малка мярка</span>
      </span>

      <label for="saleunit">Мярка за продажба</label>
      <select id="saleunit" @bind="_model.DefaultSaleUnitName">
        <option value="">най-голямата</option>
        @foreach (var unit in _model.Units.Where(u => u.Name.Length > 0))
        {
          <option value="@unit.Name">@unit.Name</option>
        }
      </select>
    </div>
    <p class="muted">Без надценка на стоката се ползва надценката на групата, а без нея — @CatalogErrors.DefaultMarkupPercent.ToString("0.##") %.</p>
  </fieldset>
  }
  else if (_tab == Tab.Units)
  {
  <fieldset>
    <legend>Мерки</legend>
    <p class="muted">Коефициент = брой от най-малката мярка. Точно една мярка има коефициент 1.</p>
    <table class="grid">
      <thead><tr><th>Мярка</th><th class="num">Коефициент</th><th></th></tr></thead>
      <tbody>
        @foreach (var unit in _model.Units)
        {
          <tr>
            <td><input @bind="unit.Name" maxlength="50" aria-label="Име на мярка" /></td>
            <td class="num">
              <input type="number" min="1" @bind="unit.Factor" disabled="@(unit.Id is not null)" aria-label="Коефициент" />
            </td>
            <td>
              @if (unit.Id is null)
              {
                <button class="link" title="Премахни" @onclick="() => _model.Units.Remove(unit)">✕</button>
              }
            </td>
          </tr>
        }
      </tbody>
    </table>
    <button class="secondary" @onclick="AddUnit">Добави мярка</button>
  </fieldset>
  }
  else
  {
  <fieldset>
    <legend>Баркодове</legend>
    <table class="grid">
      <thead><tr><th>Баркод</th><th>Мярка</th><th></th></tr></thead>
      <tbody>
        @foreach (var barcode in _model.Barcodes)
        {
          <tr>
            <td><input @bind="barcode.Code" maxlength="14" inputmode="numeric" aria-label="Баркод" /></td>
            <td>
              <select @bind="barcode.UnitName" aria-label="Мярка на баркода">
                @foreach (var unit in _model.Units)
                {
                  <option value="@unit.Name">@unit.Name</option>
                }
              </select>
            </td>
            <td>
              @if (barcode.Id is null)
              {
                <button class="link" title="Премахни" @onclick="() => _model.Barcodes.Remove(barcode)">✕</button>
              }
            </td>
          </tr>
        }
      </tbody>
    </table>
    <button class="secondary" @onclick="AddBarcode">Добави баркод</button>
  </fieldset>
  }

  @if (_error is not null)
  {
    <p class="alert error" role="alert">@_error</p>
  }
  @if (_saved)
  {
    <p class="alert success" role="status">Записано.</p>
  }

  <div class="toolbar">
    <button @onclick="Save" disabled="@_saving">Запиши</button>
    <a class="button secondary" href="catalog">Назад</a>
  </div>
}

@code {
  [Parameter] public Guid? Id { get; set; }

  private enum Tab { Main, Prices, Units, Barcodes }

  private static readonly (Tab Tab, string Label)[] Tabs =
    [(Tab.Main, "Основни данни"), (Tab.Prices, "Цени и запаси"), (Tab.Units, "Мерки"), (Tab.Barcodes, "Баркодове")];

  private Tab _tab = Tab.Main;
  private IJSObjectReference? _module;

  private ProductFormModel? _model;
  private IReadOnlyList<ReferenceItemView> _manufacturers = [];
  private IReadOnlyList<ReferenceItemView> _groups = [];
  private IReadOnlyList<ReferenceItemView> _shelves = [];
  private bool _notFound;
  private string? _error;
  private bool _saved;
  private bool _saving;

  private string Title => Id is null ? "Нова стока" : "Редакция на стока";

  protected override async Task OnParametersSetAsync()
  {
    _error = null;
    _notFound = false;
    _manufacturers = await Manufacturers.ListAsync();
    _groups = await Groups.ListAsync();
    _shelves = await Shelves.ListAsync();

    if (Id is not { } id)
    {
      _model = ProductFormModel.New();
      return;
    }

    var view = await GetProduct.HandleAsync(id);
    _notFound = view is null;
    _model = view is null ? null : ProductFormModel.From(view);
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      try
      {
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./Features/Catalog/Products/ProductEdit.razor.js");
        await _module.InvokeVoidAsync("start");
      }
      catch (JSDisconnectedException)
      {
      }
    }
  }

  public async ValueTask DisposeAsync()
  {
    if (_module is not null)
    {
      try
      {
        await _module.InvokeVoidAsync("stop");
        await _module.DisposeAsync();
      }
      catch (JSDisconnectedException)
      {
      }
    }
  }

  /// <summary>Active items, plus the selected one even if it was deactivated since.</summary>
  private static IEnumerable<ReferenceItemView> Options(IReadOnlyList<ReferenceItemView> items, string selectedId) =>
    items.Where(i => i.IsActive || i.Id.ToString() == selectedId);

  private void AddUnit()
  {
    var largest = _model!.Units.Count == 0 ? 1 : _model.Units.Max(u => u.Factor);
    _model.Units.Add(new ProductFormModel.UnitRow { Factor = largest * 10 });
    _saved = false;
  }

  private void AddBarcode()
  {
    var unit = _model!.Units.OrderByDescending(u => u.Factor).FirstOrDefault()?.Name ?? string.Empty;
    _model.Barcodes.Add(new ProductFormModel.BarcodeRow { UnitName = unit });
    _saved = false;
  }

  private async Task Save()
  {
    _saving = true;
    _error = null;
    _saved = false;

    try
    {
      if (Id is { } id)
      {
        var result = await UpdateProduct.HandleAsync(id, _model!.ToInput());
        if (result.IsFailure)
        {
          _error = result.Error.Message;
          return;
        }

        // Reload so that new units and barcodes get their ids (and become non-removable).
        var view = await GetProduct.HandleAsync(id);
        _model = view is null ? _model : ProductFormModel.From(view);
        _saved = true;
      }
      else
      {
        var result = await CreateProduct.HandleAsync(_model!.ToInput());
        if (result.IsFailure)
        {
          _error = result.Error.Message;
          return;
        }

        Navigation.NavigateTo($"catalog/{result.Value}");
      }
    }
    finally
    {
      _saving = false;
    }
  }
}
