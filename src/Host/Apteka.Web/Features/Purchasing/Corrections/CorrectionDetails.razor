@page "/purchasing/corrections/{Id:guid}"
@using Apteka.Purchasing.Application.Corrections
@using Apteka.Web.Features.Shared
@inject GetCorrectionHandler GetCorrection

<PageTitle>Корекционна складова разписка</PageTitle>

@if (_notFound)
{
  <p class="alert error">Корекцията не е намерена.</p>
}
else if (_view is not null)
{
  <h1>Корекционна складова разписка № @_view.Number</h1>

  <div class="doc-header card">
    <div><span class="muted">Към разписка</span><strong><a href="purchasing/deliveries/@_view.DeliveryId">№ @_view.DeliveryNumber (ф-ра @_view.InvoiceNo)</a></strong></div>
    <div><span class="muted">Известие</span><strong>@(_view.NoteNo ?? "—") от @Formats.Date(_view.NoteDate)</strong></div>
    <div><span class="muted">Записана</span><strong>@Formats.LocalTime(_view.CreatedAt)</strong></div>
    <div><span class="muted">Основание</span><strong>@(_view.Reason ?? "—")</strong></div>
  </div>

  <table class="grid">
    <thead><tr><th>Ред</th><th>Стока</th><th>Партида</th><th>Мярка</th><th class="num">Корекция</th><th class="num">Покупна цена</th><th class="num">Сума</th></tr></thead>
    <tbody>
      @foreach (var line in _view.Lines)
      {
        <tr>
          <td>@line.DeliveryLinePosition</td>
          <td>@line.ProductName</td>
          <td>@line.BatchNo</td>
          <td>@line.UnitName</td>
          <td class="num">@line.QuantityDelta.ToString("+0;−0")</td>
          <td class="num">@Formats.Price(line.UnitPurchasePrice)</td>
          <td class="num">@Formats.Euro(line.PurchaseTotal)</td>
        </tr>
      }
    </tbody>
  </table>
  <div class="toolbar">
    <span>Промяна на сумата без ДДС: <strong>@Formats.Euro(_view.PurchaseTotal)</strong></span>
    <a class="button secondary" href="purchasing/corrections">Към корекциите</a>
  </div>
}

@code {
  [Parameter] public Guid Id { get; set; }

  private CorrectionView? _view;
  private bool _notFound;

  protected override async Task OnParametersSetAsync()
  {
    _view = await GetCorrection.HandleAsync(Id);
    _notFound = _view is null;
  }
}
