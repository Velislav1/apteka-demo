@page "/purchasing/deliveries/new"
@page "/purchasing/deliveries/{Id:guid}"
@implements IAsyncDisposable
@using Apteka.Catalog.Contracts
@using Apteka.Inventory.Contracts
@using Apteka.Purchasing.Application.Deliveries
@using Apteka.Purchasing.Application.Suppliers
@using Apteka.Sales.Domain.Pricing
@using Apteka.SharedKernel
@using Apteka.Web.Features.Shared
@using Microsoft.JSInterop
@inject GetDeliveryHandler GetDelivery
@inject SaveDeliveryDraftHandler SaveDraft
@inject PostDeliveryHandler Post
@inject SuppliersHandler Suppliers
@inject ICatalogLookup Catalog
@inject IStockQueries Stock
@inject TimeProvider Clock
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject Apteka.Purchasing.Application.Corrections.DeliveryCorrectionsHandler DeliveryCorrections

@* „Складова разписка“ as in Apteka Expert 2: first the invoice (header), then the lines — form on top, table below. *@

<PageTitle>Складова разписка</PageTitle>

<h1>
  Складова разписка
  @if (_model is { Number: > 0 })
  {
    <span>№ @_model.Number</span>
  }
  @if (_model is not null && Id is not null)
  {
    <DeliveryStatusBadge Status="_model.Status" />
  }
</h1>

@if (_notFound)
{
  <p class="alert error">Доставката не е намерена.</p>
}
else if (_model is not null)
{
  <div @onkeydown="OnKeyDown">
    @if (Id is null || _editHeader)
    {
      @* Step 1: the invoice. *@
      <fieldset class="header-form">
        <legend>Фактура</legend>
        <div class="form-grid">
          <label for="supplier">Доставчик</label>
          <select id="supplier" @bind="_model.SupplierId" @bind:after="SupplierChanged">
            <option value="">— изберете —</option>
            @foreach (var supplier in _suppliers.Where(s => s.IsActive || s.Id.ToString() == _model.SupplierId))
            {
              <option value="@supplier.Id">@supplier.Name</option>
            }
          </select>

          <label for="invoice">Фактура №</label>
          <input id="invoice" @bind="_model.InvoiceNo" maxlength="30" />

          <label for="invoicedate">Фактура дата</label>
          <input id="invoicedate" type="date" @bind="_model.InvoiceDate" />

          <label for="paymentdays">Дни за плащане</label>
          <input id="paymentdays" type="number" min="0" max="365" @bind="_model.PaymentTermDays" @bind:event="oninput" />

          <span>Падеж</span>
          <strong>@Formats.Date(_model.DueDate)</strong>
        </div>
        <div class="toolbar">
          <button @onclick="ConfirmHeader" disabled="@_busy">Потвърди</button>
          @if (Id is not null)
          {
            <button class="secondary" @onclick="() => _editHeader = false">Отказ</button>
          }
          else
          {
            <a class="button secondary" href="purchasing/deliveries">Отказ</a>
          }
        </div>
      </fieldset>
    }
    else
    {
      <div class="doc-header card">
        <div><span class="muted">Доставчик</span><strong>@SupplierName</strong></div>
        <div><span class="muted">Фактура №</span><strong>@_model.InvoiceNo</strong></div>
        <div><span class="muted">Фактура дата</span><strong>@Formats.Date(_model.InvoiceDate)</strong></div>
        <div><span class="muted">Падеж</span><strong>@Formats.Date(_model.DueDate) (@_model.PaymentTermDays дни)</strong></div>
        @if (!_model.IsReadOnly)
        {
          <button class="secondary" @onclick="() => _editHeader = true">Промени</button>
        }
      </div>

      @if (!_model.IsReadOnly)
      {
        @* Step 2: one line at a time. *@
        <div class="entry">
          <fieldset class="entry-form">
            <legend>@(_editingIndex is null ? "Нов ред" : $"Редакция на ред {_editingIndex + 1}")</legend>

            <div class="product-search">
              <label for="productsearch">Стока</label>
              <input id="productsearch" @ref="_searchInput" placeholder="Код, баркод или име и Enter" autocomplete="off"
                     @bind="_search" @bind:event="oninput" @onkeydown="OnSearchKeyDown" />
            </div>

            @if (_matches.Count > 0)
            {
              <ol class="picker-list">
                @foreach (var product in _matches)
                {
                  <li><button class="linklike" @onclick="() => Select(product, null)">@product.Name</button></li>
                }
              </ol>
            }

            @if (_line is not null)
            {
              <div class="line-grid" @onkeydown="OnLineKeyDown">
                <label>Количество
                  <span class="qty">
                    <input id="quantity" @ref="_quantityInput" type="number" min="1" @bind="_line.Quantity" @bind:event="oninput" />
                    <select @bind="_line.UnitId" @bind:after="ApplyLastPrice" aria-label="Мярка (F12)">
                      @foreach (var unit in _line.Units.OrderByDescending(u => u.Factor))
                      {
                        <option value="@unit.UnitId">@unit.Name</option>
                      }
                    </select>
                  </span>
                </label>
                <label>Цена ТЕ без ДДС<input type="number" min="0" step="0.0001" @bind="_line.UnitPurchasePrice" @bind:event="oninput" @bind:after="_line.ApplyMarkup" /></label>
                <label>Отстъпка ТЕ %<input type="number" min="0" max="100" step="0.01" @bind="_line.SupplierDiscountPercent" @bind:event="oninput" @bind:after="_line.ApplyMarkup" /></label>
                <label>Покупна цена<output>@Formats.Price(_line.NetUnitPurchasePrice)</output></label>
                <label>Търг. надценка %<input type="number" min="0" step="0.01" @bind="_line.MarkupPercent" @bind:event="oninput" @bind:after="_line.ApplyMarkup" /></label>
                <label>Продажна цена с ДДС<input type="number" min="0" step="0.01" @bind="_line.SalePrice" @bind:event="oninput" @bind:after="() => _line.MarkupPercent = null" /></label>
                <label>Партида<input @bind="_line.BatchNo" @bind:event="oninput" maxlength="30" /></label>
                <label>Срок на годност<input type="date" @bind="_line.ExpiryDate" /></label>
              </div>
              <div class="toolbar entry-actions">
                <button @onclick="AddLine" disabled="@_busy">@(_editingIndex is null ? "Добави" : "Запиши реда") <kbd>Enter</kbd></button>
                <button class="secondary" @onclick="ClearLine">Отказ</button>
              </div>
            }
          </fieldset>

          <aside class="product-panel card">
            <h2>Данни за стоката</h2>
            @if (_line is null)
            {
              <p class="muted">Изберете стока.</p>
            }
            else
            {
              <dl>
                <dt>Име</dt><dd>@_line.ProductName</dd>
                <dt>ДДС</dt><dd>@_line.VatRate.ToString("0.##") %</dd>
                <dt>Последни цени дост. / прод.</dt>
                <dd>
                  @if (_last is null)
                  {
                    <span class="muted">няма предишна доставка</span>
                  }
                  else
                  {
                    @Formats.Price(_last.PurchasePricePerBaseUnit * _line.UnitFactor) <span class="muted">/</span> @Formats.Euro(LastSalePrice(_line.UnitFactor))
                    <small class="muted">(@_line.UnitName, @Formats.LocalTime(_last.ReceivedAt))</small>
                  }
                </dd>
                <dt>Реална надценка</dt><dd>@RealMarkup</dd>
              </dl>
            }
          </aside>
        </div>
      }

      @if (_model.Lines.Count == 0)
      {
        <p class="muted">Няма редове.</p>
      }
      else
      {
        <table class="grid lines-table">
          <thead>
            <tr>
              <th>№</th><th>Наименование</th><th>Партида</th><th>Годна до</th><th class="num">Кол.</th><th>Мярка</th>
              <th class="num">Цена ТЕ</th><th class="num">Отст. %</th><th class="num">Покупна</th><th class="num">Надц. %</th><th class="num">Прод. цена</th><th class="num">Сума</th>
            </tr>
          </thead>
          <tbody>
            @for (var i = 0; i < _model.Lines.Count; i++)
            {
              var index = i;
              var line = _model.Lines[i];
              <tr class="@(index == _selected ? "selected" : null)" @onclick="() => _selected = index">
                <td>@(index + 1)</td>
                <td>@line.ProductName</td>
                <td>@line.BatchNo</td>
                <td>@Formats.Date(line.ExpiryDate)</td>
                <td class="num">@line.Quantity</td>
                <td>@line.UnitName</td>
                <td class="num">@Formats.Price(line.UnitPurchasePrice)</td>
                <td class="num">@(line.SupplierDiscountPercent == 0 ? "" : line.SupplierDiscountPercent.ToString("0.##"))</td>
                <td class="num">@Formats.Price(line.NetUnitPurchasePrice)</td>
                <td class="num">@(line.MarkupPercent?.ToString("0.##"))</td>
                <td class="num">@Formats.Euro(line.SalePrice)</td>
                <td class="num">@line.PurchaseTotal</td>
              </tr>
            }
          </tbody>
        </table>
      }

      <div class="doc-footer card">
        <span>Общо за плащане (без ДДС): <strong>@Formats.Euro(_model.PurchaseTotal)</strong></span>
        <span>Общо по прод. цени: <strong>@Formats.Euro(_model.SaleTotal)</strong></span>
        <span>Бр. позиции: <strong>@_model.Lines.Count</strong></span>
      </div>

      @if (_error is not null)
      {
        <p class="alert error" role="alert">@_error</p>
      }
      @if (_message is not null)
      {
        <p class="alert success" role="status">@_message</p>
      }

      <div class="toolbar">
        @if (!_model.IsReadOnly)
        {
          @if (_confirmPost)
          {
            <button @onclick="PostDelivery" disabled="@_busy">Потвърди приключването</button>
            <button class="secondary" @onclick="() => _confirmPost = false">Отказ</button>
            <span class="muted">Стоката се заприхождава; после разписката не може да се променя.</span>
          }
          else
          {
            <button @onclick="() => _confirmPost = true" disabled="@(_busy || _model.Lines.Count == 0)">Приключване <kbd>Ctrl+Enter</kbd></button>
            <button class="secondary" @onclick="EditSelected" disabled="@(_selected is null)">Редакция <kbd>F6</kbd></button>
            <button class="secondary" @onclick="DeleteSelected" disabled="@(_selected is null)">Изтриване <kbd>F8</kbd></button>
          }
        }
        else
        {
          <a class="button" href="purchasing/corrections/new?delivery=@Id">Корекция</a>
        }
        <a class="button secondary" href="purchasing/deliveries">Затвори</a>
      </div>

      @if (_corrections is { Count: > 0 })
      {
        <h2>Корекции</h2>
        <ul class="corrections">
          @foreach (var correction in _corrections)
          {
            <li>
              <a href="purchasing/corrections/@correction.Id">Корекция № @correction.Number</a>
              от @Formats.LocalTime(correction.CreatedAt)@(correction.NoteNo is null ? null : $", известие {correction.NoteNo}") —
              <strong>@Formats.Euro(correction.PurchaseTotal)</strong>
            </li>
          }
        </ul>
      }
    }

    @if (Id is null && _error is not null)
    {
      <p class="alert error" role="alert">@_error</p>
    }
  </div>
}

@code {
  [Parameter] public Guid? Id { get; set; }

  private const int MaxMatches = 10;

  private DeliveryFormModel? _model;
  private IReadOnlyList<SupplierView> _suppliers = [];
  private IReadOnlyList<CatalogProductInfo> _matches = [];
  private DeliveryFormModel.LineRow? _line;
  private LastReceipt? _last;
  private int? _editingIndex;
  private int? _selected;
  private string _search = string.Empty;
  private string? _error;
  private string? _message;
  private bool _notFound;
  private bool _busy;
  private bool _confirmPost;
  private bool _editHeader;
  private IReadOnlyList<Apteka.Purchasing.Application.Corrections.DeliveryCorrectionItem>? _corrections;
  private ElementReference _searchInput;
  private ElementReference _quantityInput;
  private bool _focusQuantity;
  private bool _focusSearch;
  private IJSObjectReference? _module;

  private DateOnly Today => BulgarianTime.Today(Clock.GetUtcNow());

  private string SupplierName => _suppliers.FirstOrDefault(s => s.Id.ToString() == _model?.SupplierId)?.Name ?? "—";

  private string RealMarkup => _line is { NetUnitPurchasePrice: > 0 } line && line.SalePrice > 0
    ? $"{(line.SalePrice / (1 + (line.VatRate / 100m)) / line.NetUnitPurchasePrice - 1) * 100m:0.##} %"
    : "—";

  protected override async Task OnParametersSetAsync()
  {
    // _error and _message survive the move from „new“ to the saved draft's address on purpose.
    _suppliers = await Suppliers.ListAsync();
    _notFound = false;
    _confirmPost = false;
    _editHeader = false;

    if (Id is not { } id)
    {
      _model = DeliveryFormModel.New(Today);
      return;
    }

    var view = await GetDelivery.HandleAsync(id);
    _notFound = view is null;
    _model = view is null ? null : DeliveryFormModel.From(view);
    _corrections = view is { Status: Apteka.Purchasing.Domain.Deliveries.DeliveryStatus.Posted } ? (await DeliveryCorrections.HandleAsync(id)).Items : null;
    _focusSearch = true;
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      try
      {
        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./Features/Purchasing/Deliveries/DeliveryEdit.razor.js");
        await _module.InvokeVoidAsync("start");
      }
      catch (JSDisconnectedException)
      {
      }
    }

    if (_focusQuantity)
    {
      _focusQuantity = false;
      await TryFocus(_quantityInput);
    }
    else if (_focusSearch)
    {
      _focusSearch = false;
      await TryFocus(_searchInput);
    }
  }

  private static async Task TryFocus(ElementReference element)
  {
    try
    {
      await element.FocusAsync();
    }
    catch (Exception ex) when (ex is JSException or InvalidOperationException or JSDisconnectedException)
    {
      // The element is not on the page (e.g. a posted delivery).
    }
  }

  /// <summary>Keys of the whole screen: Ctrl+Enter приключване, F6 редакция, F8 изтриване, F12 мярка.</summary>
  private async Task OnKeyDown(KeyboardEventArgs e)
  {
    if (_model is null || _model.IsReadOnly || Id is null || _editHeader)
    {
      return;
    }

    switch (e.Key)
    {
      case "Enter" when e.CtrlKey && _model.Lines.Count > 0:
        if (_confirmPost)
        {
          await PostDelivery();
        }
        else
        {
          _confirmPost = true;
        }

        break;
      case "F6":
        EditSelected();
        break;
      case "F8":
        await DeleteSelected();
        break;
      case "F12" when _line is not null:
        var units = _line.Units.OrderByDescending(u => u.Factor).ToList();
        var next = units[(units.FindIndex(u => u.UnitId.ToString() == _line.UnitId) + 1) % units.Count];
        _line.UnitId = next.UnitId.ToString();
        ApplyLastPrice();
        break;
      case "Escape" when _confirmPost:
        _confirmPost = false;
        break;
    }
  }

  /// <summary>A new supplier brings its own payment term (it can still be changed by hand).</summary>
  private void SupplierChanged()
  {
    if (_model is not null && _suppliers.FirstOrDefault(s => s.Id.ToString() == _model.SupplierId) is { } supplier)
    {
      _model.PaymentTermDays = supplier.PaymentTermDays;
    }
  }

  private async Task ConfirmHeader()
  {
    if (await SaveAsync() is { } id && Id != id)
    {
      Navigation.NavigateTo($"purchasing/deliveries/{id}");
    }
    else
    {
      _editHeader = _error is not null;
    }
  }

  private async Task OnSearchKeyDown(KeyboardEventArgs e)
  {
    if (e.Key == "Enter" && !e.CtrlKey)
    {
      await SearchProducts();
    }
  }

  private async Task OnLineKeyDown(KeyboardEventArgs e)
  {
    if (e.Key == "Enter" && !e.CtrlKey)
    {
      await AddLine();
    }
  }

  /// <summary>A barcode selects its product and unit at once; text shows the matching products.</summary>
  private async Task SearchProducts()
  {
    _error = null;
    var text = _search.Trim();
    if (text.Length == 0)
    {
      return;
    }

    if (CatalogCodes.LooksLikeCode(text))
    {
      if (await Catalog.FindByCodeAsync(long.Parse(text, System.Globalization.CultureInfo.InvariantCulture)) is { } byCode)
      {
        await Select(byCode, null);
      }
      else
      {
        _error = $"Няма стока с код {text}.";
      }

      return;
    }

    if (text.All(char.IsAsciiDigit) && await Catalog.FindByBarcodeAsync(text) is { } scanned)
    {
      if (await Catalog.GetProductAsync(scanned.ProductId) is { } product)
      {
        await Select(product, scanned.UnitId);
      }

      return;
    }

    _matches = await Catalog.SearchProductsAsync(text, MaxMatches);
    if (_matches.Count == 0)
    {
      _error = $"Няма стока „{text}“.";
    }
    else if (_matches.Count == 1)
    {
      await Select(_matches[0], null);
    }
  }

  private async Task Select(CatalogProductInfo product, Guid? unitId)
  {
    _line = DeliveryFormModel.NewLine(product, unitId, Today);
    _editingIndex = null;
    _matches = [];
    _search = product.Name;
    _last = await Stock.GetLastReceiptAsync(product.ProductId);
    ApplyLastPrice();
    _focusQuantity = true;
  }

  /// <summary>
  /// As in Apteka Expert 2, the suggested sale price is the last one, in the chosen unit; a product never delivered
  /// gets its sale price from the markup (product's, else group's, else 25 %) once the purchase price is typed.
  /// </summary>
  private void ApplyLastPrice()
  {
    if (_line is not null && _last is not null && _editingIndex is null)
    {
      _line.SalePrice = LastSalePrice(_line.UnitFactor);
      _line.MarkupPercent = null;
    }
  }

  private decimal LastSalePrice(int factor) =>
    _last is null ? 0m : SalePricing.UnitPrice(factor, _last.PricedUnitFactor, _last.PricedUnitSalePrice, _last.SalePricePerBaseUnit);

  private async Task AddLine()
  {
    if (_line is null || _model is null)
    {
      return;
    }

    var previous = _model.Lines.ToList();
    if (_editingIndex is { } index)
    {
      _model.Lines[index] = _line;
    }
    else
    {
      _model.Lines.Add(_line);
    }

    if (await SaveAsync() is null)
    {
      // Keep the form so the user can fix the line.
      _model.Lines.Clear();
      _model.Lines.AddRange(previous);
      return;
    }

    ClearLine();
  }

  private void ClearLine()
  {
    _line = null;
    _last = null;
    _editingIndex = null;
    _search = string.Empty;
    _matches = [];
    _focusSearch = true;
  }

  private void EditSelected()
  {
    if (_selected is { } index && _model is not null && index < _model.Lines.Count)
    {
      _line = DeliveryFormModel.Copy(_model.Lines[index]);
      _editingIndex = index;
      _search = _line.ProductName;
      _focusQuantity = true;
    }
  }

  private async Task DeleteSelected()
  {
    if (_selected is not { } index || _model is null || index >= _model.Lines.Count)
    {
      return;
    }

    var removed = _model.Lines[index];
    _model.Lines.RemoveAt(index);
    if (await SaveAsync() is null)
    {
      _model.Lines.Insert(index, removed);
      return;
    }

    _selected = null;
  }

  /// <summary>Every change is saved at once as a draft (as in Apteka Expert 2, the document is kept as you type).</summary>
  private async Task<Guid?> SaveAsync()
  {
    _busy = true;
    _error = null;
    _message = null;
    try
    {
      var result = await SaveDraft.HandleAsync(Id, _model!.ToInput());
      if (result.IsFailure)
      {
        _error = result.Error.Message;
        return null;
      }

      if (Id == result.Value)
      {
        var view = await GetDelivery.HandleAsync(result.Value);
        if (view is not null)
        {
          _model = DeliveryFormModel.From(view);
        }
      }

      return result.Value;
    }
    finally
    {
      _busy = false;
    }
  }

  private async Task PostDelivery()
  {
    _busy = true;
    _error = null;
    try
    {
      var posted = await Post.HandleAsync(Id!.Value);
      if (posted.IsFailure)
      {
        _error = posted.Error.Message;
        return;
      }

      _message = "Складовата разписка е приключена. Стоката е заприходена.";
      var view = await GetDelivery.HandleAsync(Id.Value);
      _model = view is null ? _model : DeliveryFormModel.From(view);
      ClearLine();
    }
    finally
    {
      _busy = false;
      _confirmPost = false;
    }
  }

  public async ValueTask DisposeAsync()
  {
    if (_module is not null)
    {
      try
      {
        await _module.InvokeVoidAsync("stop");
        await _module.DisposeAsync();
      }
      catch (JSDisconnectedException)
      {
      }
    }
  }
}
